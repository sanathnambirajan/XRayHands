*.app

# Autogenerated by Burst / Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*

# --- X-Ray Hands project specific ---
# Raw dataset downloads are never committed (see docs/DATA.md)
/data_raw/
# Python virtual environment and caches
/tools/.venv/
__pycache__/
*.pyc
.pytest_cache/
